{
  "name": "stackbase-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": {
    "name": "Vijay Singh",
    "url": "https://github.com/vijaysingh2219"
  },
  "scripts": {
    "build": "turbo build --filter docs --filter stackbase",
    "build:cli": "pnpm --filter ./packages/stackbase build",
    "clean": "turbo clean",
    "dev": "turbo dev --filter docs",
    "lint": "turbo lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:path": "prettier --write",
    "format:check": "prettier --check .",
    "check-types": "turbo check-types",
    "start": "turbo start",
    "test": "turbo test",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "catalog:eslint",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "prettier-plugin-packagejson": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier",
    "turbo": "catalog:core",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  }
}
