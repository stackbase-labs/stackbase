{
  "name": "stackbase",
  "version": "2.0.0-beta.0",
  "description": "Stackbase CLI for scaffolding production-ready full-stack Turborepo applications with Next.js, Express, Better Auth, and Prisma",
  "type": "module",
  "homepage": "https://stackbase-labs.vercel.app/docs/cli",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "Vijay Singh",
    "url": "https://github.com/vijaysingh2219"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackbase-labs/stackbase.git",
    "directory": "packages/stackbase"
  },
  "bugs": {
    "url": "https://github.com/stackbase-labs/stackbase/issues"
  },
  "files": [
    "dist/index.js"
  ],
  "keywords": [
    "stackbase",
    "starter",
    "boilerplate",
    "scaffold",
    "cli",
    "full-stack",
    "monorepo",
    "turborepo",
    "nextjs",
    "express",
    "typescript",
    "prisma",
    "better-auth",
    "shadcn-ui",
    "saas",
    "template"
  ],
  "bin": {
    "stackbase": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublish": "pnpm build",
    "pub:release": "pnpm build && pnpm publish --access public",
    "pub:beta": "pnpm build && pnpm publish --no-git-checks --access public --tag beta",
    "pub:rc": "pnpm build && pnpm publish --no-git-checks --access public --tag rc",
    "pub:next": "pnpm build && pnpm publish --no-git-checks --access public --tag next",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^14.0.3",
    "degit": "^3.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/degit": "^2.8.6",
    "@types/node": "catalog:dev",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "catalog:eslint",
    "tsup": "^8.5.1",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
