{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@workspace/db#db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "PORT",
        "LOG_LEVEL",
        "ALLOWED_ORIGINS",
        "CORS_ALLOW_MISSING_ORIGIN",
        "POD_NAME"
      ]
    },
    "dev": {
      "dependsOn": ["@workspace/db#db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "env": [
        "NODE_ENV",
        "PORT",
        "LOG_LEVEL",
        "ALLOWED_ORIGINS",
        "CORS_ALLOW_MISSING_ORIGIN",
        "POD_NAME"
      ]
    }
  }
}
