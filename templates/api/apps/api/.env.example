# Environment
NODE_ENV=development
LOG_LEVEL=info

# Allowed Origins for CORS (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# Allow requests without an Origin header (e.g., mobile apps, curl).
# Set to true only if you intentionally support such clients.
CORS_ALLOW_MISSING_ORIGIN=false

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/api-app

# PORT
PORT=4000

# Google OAuth (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Better Auth
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=your-betterauth-secret-key-min-32-chars

# Upstash Redis (for rate limiting - local dev uses docker-compose up)
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=api-local-redis

# File Storage (S3 / Cloudflare R2 / MinIO - local dev uses MinIO from docker-compose.yml)
S3_BUCKET=my-app-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://cdn.yourdomain.com
