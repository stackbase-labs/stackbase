# Local Development Services (via Docker Compose)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stackbase-app"

# Upstash Redis (Local Docker Dev via Serverless Redis HTTP)
UPSTASH_REDIS_REST_URL="http://127.0.0.1:8079"
UPSTASH_REDIS_REST_TOKEN="stackbase-local-redis"

# Standard Redis (TCP)
REDIS_URL="redis://127.0.0.1:6379"

# S3 / MinIO Local Storage
S3_BUCKET="my-app-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_FORCE_PATH_STYLE="true"
