# Upstash Redis (for rate limiting)
# Local development uses Serverless Redis HTTP from docker-compose.yml
UPSTASH_REDIS_REST_URL="http://127.0.0.1:8079"
UPSTASH_REDIS_REST_TOKEN="stackbase-local-redis"

# Production Upstash Redis credentials:
# UPSTASH_REDIS_REST_URL="https://YOUR_REDIS_ENDPOINT.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
