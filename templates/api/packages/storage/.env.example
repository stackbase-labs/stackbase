# S3 / Cloudflare R2 / MinIO Storage Configuration
# Local development uses MinIO from docker-compose.yml
S3_BUCKET=my-app-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

# Optional: Public CDN or custom domain URL for serving assets (e.g. https://cdn.yourdomain.com or R2 public bucket URL)
# S3_PUBLIC_URL=
