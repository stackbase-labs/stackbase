{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "12",
  "tasks": {
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**/*"],
      "env": ["DATABASE_URL", "API_INTERNAL_URL", "NEXT_PUBLIC_API_URL"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "env": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "NEXT_PUBLIC_BASE_URL",
        "API_INTERNAL_URL",
        "NODE_ENV",
        "PORT",
        "ALLOWED_ORIGINS",
        "CORS_ALLOW_MISSING_ORIGIN",
        "POD_NAME",
        "RESEND_TOKEN",
        "RESEND_EMAIL_FROM",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "LOG_LEVEL",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_ENDPOINT",
        "S3_PUBLIC_URL",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "start": {
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    }
  }
}
